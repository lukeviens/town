-- vim: set ft=lua:
-- resident: how a Lua resident is written, the same in every town, read into each file before it.
-- Not named .lua, so `lua` does not take it for a resident. Its README is beside it.

-- a word in each tense, so none types a tense by hand: a typo is no word
function intent(kind, body) return { kind = kind, tense = "future",  body = body } end
function fact(kind, body)   return { kind = kind, tense = "present", body = body } end
function event(kind, body)  return { kind = kind, tense = "past",    body = body } end

-- languages: grammars, as town's README's *languages* reads them. `parts(name, bytes)` reads with
-- one, `bytes(name, parts)` writes, and so does `as` on the files.
-- each piece is marked as one, so `{ name = g }` is a part whatever its name: `text`, `map`, `int`
local piece = {}
local function made(t) return setmetatable(t, piece) end
local function item(g)
  if type(g) == "string" then return made{ lit = g } end
  if getmetatable(g) == piece then return g end
  if type(g) == "table" then
    local name, is = next(g)
    if name ~= nil and next(g, name) == nil then return made{ part = { name, item(is) } } end
  end
  error("not a grammar: a string, a piece, or { name = piece }", 3)
end
local function items(gs)
  local out = {}; for i, g in ipairs(gs) do out[i] = item(g) end; return out
end
local function counted(g, n) if n then return { item(g), n } end; return item(g) end
function upto(s)      return made{ upto = s } end             -- text up to s, which is passed over
function but(s)       return made{ but = s } end              -- text of a byte or more, none in s
function seq(gs)      return made{ seq = items(gs) } end      -- each in turn
function choice(gs)   return made{ choice = items(gs) } end   -- the first that reads
function many(g, n)   return made{ many = counted(g, n) } end -- as many as read, or n, in order
function map(g, n)    return made{ map = counted(g, n) } end  -- the same, by `key`: each a `value`
function unless(g)    return made{ unless = item(g) } end     -- nothing, where g would not read
-- a whole number: { size = bytes, signed, order = "big"|"little", from, to, base, negative }, from
-- and to bounding what the bytes contain, and read as that less base; or, negative, as base less
-- that
function int(o)       return made{ int = o or {} } end
function float(o)     return made{ float = o or {} } end      -- { size = 2|4|8, order }
-- a count, n, is a number; a piece that reads one; or the name of a part read before it in the
-- same seq, which is then not kept, and is written as the length of what it counts
function text(n)      return made{ text = n } end             -- text of n bytes
function raw(n)       return made{ raw = n } end              -- n bytes; written, a string too
function whole(g)     return made{ whole = item(g) } end      -- what g reads in pieces, as one
-- what g reads, as value: nil for nothing
function be(g, value) return made{ be = { item(g), value } } end
function ref(name)    return made{ ref = name } end           -- the language of that name

-- files a resident keeps: read a whole file (nil if absent), post one so a reader sees the old or
-- the new and never neither, and mend a missing one from make(). With `as`, a file is the parts of
-- that language, not text. A post that fails is the poster's error.
function read(path, as)
  local f = io.open(path, "rb"); if not f then return nil end
  local s = f:read("*a"); f:close()
  if as then return parts(as, s) end
  return s
end
function post(path, body, as)
  if as then body = bytes(as, body) end
  local aside = path .. ".writing"
  local f, e = io.open(aside, "wb"); if not f then error("post: " .. e, 2) end
  local wrote, e = f:write(body)
  local closed, ce = f:close()   -- a full disk may fail only as it closes
  if wrote and not closed then wrote, e = nil, ce end
  if wrote then wrote, e = os.rename(aside, path) end
  if not wrote then os.remove(aside); error("post: " .. e, 2) end
end
function mend(path, make, as)
  if not read(path) then local t = make(); if t then post(path, t, as) end end
end

-- a string as one shell word: a quote inside it closes, escapes one, and reopens, as sh wants
function quote(s) return "'" .. tostring(s):gsub("'", "'\\''") .. "'" end

-- a body's copy, to add to: the caller's table may be said again
local function copy(body)
  local b = {}; for k, v in pairs(body or {}) do b[k] = v end; return b
end

-- work: run a program, `argv` as given, without blocking the town: `{ "date" }`; a shell is a
-- program, `{ "sh", "-c", cmd }`; a wait is one too, `{ "sleep", "2" }`. A past `town/work` comes
-- back with `code`, `out`, `ms` and what was sent, to match with `on`'s `by`. `where`, the file and
-- line that asked, rides along, so work's cost can be told by where it was asked.
local acting   -- the clause react is running

-- where work was asked: the line that called it, or, when `return work(…)` (a tail call) took that
-- line away, the clause that was running
local function asked()
  if not debug then return "?" end   -- absent where Lua is made safe
  local i, line = debug.getinfo(3, "Sl"), nil
  if debug.getinfo(2, "t").istailcall and acting then
    i = debug.getinfo(acting, "S"); line = i.linedefined
  end
  local s = i and i.short_src
  local src = s and (s:match('%[string "(.-)"%]') or s:match("([^/]+)$") or s)
  return src and (src .. ":" .. (line or i.currentline)) or "?"
end

function work(argv, body)
  local whole = type(argv) == "table" and #argv > 0
  for _, a in ipairs(whole and argv or {}) do whole = whole and type(a) == "string" end
  if not whole then error("work: argv is a list of strings, the program first", 2) end
  local b = copy(body)
  b.argv = argv
  b.where = asked()
  return intent("town/work", b)
end

-- join: run a program as a resident at `kind`, as town's README's *a join* reads; a past
-- `town/join` carries its `code` and what was sent.
function join(kind, argv, body)
  local b = copy(body)
  b.as, b.argv = kind, argv
  return intent("town/join", b)
end

-- on: a clause: match a word, then run act(w).
--
-- - kind: a pattern, as the README's *words* reads one: `nvim`, `nvim/`, `/nvim`.
-- - tense: `past`, `present` or `future`, if named.
-- - by: `by = "id"`, a word whose body has that field; `by = { colour = "red" }`, a word whose
--   fields are these (`true`: any value).
--   on("note", fn)  ·  on({ kind = "note", tense = "future", by = "id" }, fn)
local hears = hears   -- town's rule, as it is now: a resident's own `hears` is not what `on` keeps
function on(what, act)
  if type(what) == "string" then what = { kind = what } end
  local by = what.by
  return {
    kind = what.kind,
    match = function(w)
      if what.kind and not hears(what.kind, w.kind) then return false end
      if what.tense and (w.tense or "present") ~= what.tense then return false end
      if by then
        local b = w.body
        if type(b) ~= "table" then return false end
        if type(by) == "string" then return b[by] ~= nil end
        for k, v in pairs(by) do
          if v == true then if b[k] == nil then return false end
          elseif b[k] ~= v then return false end
        end
      end
      return true
    end,
    act = act,
  }
end

-- react: a resident from `on` clauses, and what else it is, `kinds`, `own`, `languages` and
-- `names`, by name beside them. Its `kinds` are the clauses' kinds and those it names besides; or
-- every kind ("/") if a clause names none, and `town/error` too if one names it; but those it
-- `except`s. Its `listen` runs the first matching clause.
function react(list)
  local kinds, seen, all = {}, {}, false
  local function hear(kind)
    if not seen[kind] then seen[kind] = true; kinds[#kinds + 1] = kind end
  end
  for _, c in ipairs(list) do
    if not c.kind then all = true else hear(c.kind) end
  end
  for _, kind in ipairs(list.kinds or {}) do hear(kind) end   -- kinds it names besides
  if all then kinds = seen["town/error"] and { "/", "town/error" } or { "/" } end
  return {
    kinds = kinds,
    except = list.except,
    own = list.own,
    languages = list.languages,
    names = list.names,
    listen = function(w)
      for _, c in ipairs(list) do
        if c.match(w) then
          acting = c.act
          local ok, said = pcall(c.act, w)
          acting = nil
          if not ok then error(said, 0) end
          return said
        end
      end
    end,
  }
end
