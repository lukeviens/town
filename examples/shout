#!/bin/sh
# shout: say something, and it shouts it back in capitals.
#
# A resident can be any program, not only Lua. Its first line says what it hears, and how it
# speaks: here in `words`, a word on a line, its tense, its kind, then key=value, a tab between
# each, which a shell reads with nothing but `read`. It asks clock.lua the time as any resident
# would: it says a future `time`, and listens for the past `time` that answers.
#
#   town talk future shout text=hi     a past `shouted`, HI
#   town listen                        a `shouting` fact: when it started

tab=$(printf '\t')
set -f   # a value of * is a star, not the files here

echo '{"kinds":["shout","time"],"speaks":"words"}'
printf 'future\ttime\tid=shout\n'

# the value of one key=value of the word just read
field() { for p in $pairs; do case $p in "$1="*) printf '%s' "${p#*=}" ;; esac; done; }

while IFS=$tab read -r tense kind pairs; do
  IFS=$tab
  case $tense.$kind in
    past.time)
      [ "$(field id)" = shout ] && printf 'present\tshouting\tsince=%s\n' "$(field now)" ;;
    *.shout)
      printf 'past\tshouted\ttext=%s\n' "$(field text | tr '[:lower:]' '[:upper:]')" ;;
  esac
done
